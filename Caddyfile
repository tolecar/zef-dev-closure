{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:8080} {
	log {
		format json
	}

	handle /health {
		respond 200
	}

	# zefdev.com is the old company domain; zef.dev is canonical. Both are
	# attached to this service, so the redirect happens here rather than in
	# DNS, and {uri} keeps the path and query intact.
	@zefdev host zefdev.com www.zefdev.com
	handle @zefdev {
		redir https://zef.dev{uri} permanent
	}

	handle {
		encode gzip zstd

		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
			-Server
		}

		# Go's built-in MIME table has no woff2, so the type would depend on
		# whether the host image happens to ship /etc/mime.types.
		@woff2 path *.woff2
		header @woff2 Content-Type font/woff2

		root * .
		file_server {
			hide .git
			hide .gitignore
			hide Caddyfile
			hide railway.toml
			hide README.md
		}
	}

	# Without this, try_files served index.html for anything missing, so a
	# deleted asset kept answering 200 with HTML dressed as an image.
	# A redirect says the URL is gone and sends the visitor to the notice.
	handle_errors {
		@notfound expression {err.status_code} == 404
		redir @notfound / 301
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
